# Copie para .env. Caminhos relativos a raiz do repo.
BRONZE_DIR=data/bronze
SILVER_DIR=data/silver
GOLD_DIR=data/gold
# Fim da janela alvo ANAC (AAAA-MM) e tamanho em meses. A janela real termina no ultimo mes publicado <= ANAC_END_MONTH.
ANAC_END_MONTH=2026-08
ANAC_MONTHS=24
# Agente NBA (custo zero). nenhum = mensagem por texto-modelo (padrao). ollama = Ollama local so reescreve a
# mensagem ja decidida (fallback para o texto-modelo se nao responder ou violar guardrail). Nunca API paga.
LLM_PROVIDER=nenhum
LLM_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434
